{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoniBuddy",
  "version": "0.1.15",
  "identifier": "com.monibuddy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "MoniBuddy",
        "width": 920,
        "height": 720,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "MoniBuddy Overlay",
        "url": "index.html?mode=overlay",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "resizable": false,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MTM3Q0YyRDk2QjRCRjAKUldUd1Mydlo4bndUWkNScThFU3JqMFhQMW9YZmxIRHZua21IZ3d2QmlRcGJwMGhSY05sLzFiSUcK",
      "endpoints": [
        "https://monibuddy-server.onrender.com/desktop/latest.json",
        "https://github.com/aaahyesu/MoniBuddy/releases/latest/download/latest.json"
      ]
    }
  }
}
